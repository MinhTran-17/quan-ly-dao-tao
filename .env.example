# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# Cấu hình Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Tên trường/hệ thống hiển thị ở logo (trang đăng nhập, thanh menu trên)
TEN_TRUONG=Trường Đại học Mẫu
TEN_HE_THONG=Hệ thống quản lý đào tạo

# Cấu hình kết nối MySQL (database qldt)
DB_NAME=qldt
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Cấu hình gọi AI (Gemini, dùng SDK google-genai)
# Lấy khóa tại https://aistudio.google.com/apikey — không commit khóa thật.
GEMINI_API_KEY=
# Một model dòng Flash còn dùng được ở gói miễn phí (đổi được, không cần sửa code)
GEMINI_MODEL=gemini-flash-latest
# Thời gian chờ tối đa một lượt gọi (giây)
AI_TIMEOUT_GIAY=20
# Số lần thử lại tối đa khi hết thời gian chờ, bị giới hạn tần suất (429) hoặc lỗi máy chủ (5xx)
AI_SO_LAN_THU_LAI=2
# Số ký tự tối đa cho phần nội dung gửi AI, vượt quá sẽ bị từ chối trước khi gọi API
AI_GIOI_HAN_KY_TU=8000
# Phiên bản prompt đang dùng cho chức năng tư vấn đăng ký học phần (prompts/tu_van_dang_ky/<phien_ban>/)
AI_PHIEN_BAN_TU_VAN=v1
# Phiên bản prompt đang dùng cho chức năng tóm tắt kết quả học tập (prompts/tom_tat_ket_qua/<phien_ban>/)
AI_PHIEN_BAN_TOM_TAT=v1
# Phiên bản prompt đang dùng cho chatbot hỏi đáp quy chế (prompts/hoi_dap_quy_che/<phien_ban>/)
AI_PHIEN_BAN_QUY_CHE=v1
# Ngưỡng điểm BM25 tối thiểu để một đoạn quy chế được coi là liên quan (điều chỉnh qua thực nghiệm)
AI_NGUONG_DIEM_TRUY_HOI=0.5
# Phiên bản thuật toán truy hồi cho chatbot hỏi đáp quy chế: v1 (bản cũ) hoặc v2 (bản mới, có bigram)
AI_TRUY_HOI_PHIEN_BAN=v2
